{
  "manifest_version": 2,
  "name": "Letterboxd → Кинопоиск",
  "version": "2.0.0",
  "description": "Кнопка на странице фильма в Letterboxd для перехода на этот же фильм на Кинопоиске (домен .film).",
  "browser_specific_settings": {
    "gecko": {
      "id": "letterboxd-to-kinopoisk@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "https://query.wikidata.org/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://letterboxd.com/film/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://www.kinopoisk.ru/*"
      ],
      "js": [
        "kp.js"
      ],
      "run_at": "document_idle"
    }
  ]
}